// AutoApply data model. Source of truth for DB. See docs/architecture.md.
// pgvector columns use Unsupported(); read/write them with $queryRaw (see src/vector.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------- Knowledge base (Zero Fabrication) ----------

model Profile {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  phone       String?
  city        String?
  state       String?
  linkedinUrl String?
  githubUser  String?
  portfolio   String?
  headline    String?
  summary     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ResumeStatus {
  uploaded
  parsing
  image_only
  failed
  review
  confirmed
  discarded
}

enum ResumeExtraction {
  text
  vision
  manual
}

model ResumeBase {
  id          String           @id @default(cuid())
  minioKey    String
  fileName    String
  rawText     String? // extracted text; basis for foundInSource()
  extraction  ResumeExtraction @default(text)
  status      ResumeStatus     @default(uploaded)
  parsed      Json? // ResumeDraft (@autoapply/shared kb.ts)
  error       String?
  version     Int              @default(1)
  active      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  confirmedAt DateTime?
}

enum FactKind {
  experience
  skill
  metric
  project
  education
  certification
  language
  personal
  preference
}

enum FactStatus {
  active
  archived
}

enum FactOrigin {
  resume
  linkedin
  github
  user
}

/// Usable outside dry-run only when verifiedByUser && status=active && !hasOpenConflict
/// (see usableFactsWhere in packages/db/src/facts.ts).
model Fact {
  id              String         @id @default(cuid())
  kind            FactKind
  key             String // deterministic factKey(), e.g. "skill:postgresql", "experience:xeno:2021-03"
  value           Json // FactValue (@autoapply/shared kb.ts)
  verifiedByUser  Boolean        @default(false)
  status          FactStatus     @default(active)
  hasOpenConflict Boolean        @default(false)
  missingFrom     String[] // origins where the item vanished on last sync
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sources         FactSource[]
  revisions       FactRevision[]
  conflicts       FactConflict[]

  @@unique([kind, key])
}

model FactSource {
  id         String     @id @default(cuid())
  factId     String
  fact       Fact       @relation(fields: [factId], references: [id], onDelete: Cascade)
  origin     FactOrigin
  ref        String // resume:<id>#work[2] | github:<owner/repo>:package.json | linkedin:experience[1] | user:form
  rawValue   Json
  snippet    String?
  importedAt DateTime   @default(now())
  lastSeenAt DateTime   @default(now())

  @@unique([factId, origin, ref])
  @@index([origin])
}

enum RevisionAction {
  created
  edited
  verified
  unverified
  archived
  restored
  conflict_resolved
  source_added
}

enum RevisionActor {
  user
  import
  sync
}

model FactRevision {
  id        String         @id @default(cuid())
  factId    String
  fact      Fact           @relation(fields: [factId], references: [id], onDelete: Cascade)
  action    RevisionAction
  before    Json?
  after     Json?
  actor     RevisionActor
  note      String?
  createdAt DateTime       @default(now())

  @@index([factId])
}

enum ConflictType {
  value_mismatch
  possible_duplicate
}

enum ConflictStatus {
  open
  resolved
}

model FactConflict {
  id          String         @id @default(cuid())
  factId      String
  fact        Fact           @relation(fields: [factId], references: [id], onDelete: Cascade)
  type        ConflictType
  candidates  Json // [{ origin, ref, value, importedAt }]
  otherFactId String?
  status      ConflictStatus @default(open)
  resolution  Json?
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?

  @@index([status])
}

enum SyncOutcome {
  success
  partial
  failed
}

/// Knowledge sources (github, linkedin). Job sources live in `Source`.
model ProfileSource {
  origin     FactOrigin   @id
  enabled    Boolean      @default(false)
  account    String?
  lastSyncAt DateTime?
  lastStatus SyncOutcome?
  lastError  String?
  resumeAt   DateTime?
  snapshot   Json?
  updatedAt  DateTime     @updatedAt
}

enum SyncTrigger {
  schedule
  manual
  import
}

model SyncRun {
  id         String      @id @default(cuid())
  trigger    SyncTrigger
  localDate  String // YYYY-MM-DD in America/Sao_Paulo
  startedAt  DateTime    @default(now())
  finishedAt DateTime?
  outcomes   Json        @default("{}")
  summary    Json        @default("{}")

  @@index([trigger, localDate])
}

model AnswerMemory {
  id        String                       @id @default(cuid())
  question  String
  answer    String
  evidence  String[] // Fact ids
  embedding Unsupported("vector(1024)")?
  approved  Boolean                      @default(false)
  usedCount Int                          @default(0)
  createdAt DateTime                     @default(now())
}

// ---------- Search ----------

model SearchPreference {
  id               String   @id @default(cuid())
  roles            String[]
  seniority        String[]
  stack            String[]
  locations        String[]
  workModes        String[] // remote | hybrid | onsite
  minSalary        Int?
  blockedCompanies String[]
  excludeKeywords  String[]
  scoreThreshold   Int      @default(70)
  mode             RunMode  @default(review)
  scheduleCron     String   @default("0 23-6 * * *")
  minSalaryContract String? // clt | pj | any
  judgeTopN        Int      @default(20)
  autoDiscover     Boolean  @default(false)
  discoveryCron    String   @default("0 7 * * *")
  autoTailor       Boolean  @default(false)
  autoTailorN      Int      @default(5)
  updatedAt        DateTime @updatedAt
}

enum RunMode {
  dry_run
  review
  autopilot
}

enum SourceType {
  linkedin_mcp
  jobspy // legacy, unused since F2 (one row per JobSpy site)
  indeed
  glassdoor
  google_jobs
  gupy
  greenhouse
  lever
  ashby
  workable
  remotive
  generic
}

model Source {
  id         String     @id @default(cuid())
  type       SourceType @unique
  enabled    Boolean    @default(false)
  dailyCap   Int        @default(20)
  config     Json       @default("{}")
  sessionEnc String? // encrypted Playwright storageState
  lastRunAt  DateTime?
  lastStatus String? // success | partial | failed | skipped
  lastError  String?
  jobs       Job[]
}

model Company {
  id      String  @id @default(cuid())
  name    String  @unique
  atsType String?
  atsSlug String?
  blocked Boolean @default(false)
  jobs    Job[]
}

model Job {
  id          String                       @id @default(cuid())
  sourceId    String // first source that found it
  source      Source                       @relation(fields: [sourceId], references: [id])
  externalId  String?
  url         String
  applyUrl    String?
  companyId   String?
  company     Company?                     @relation(fields: [companyId], references: [id])
  title       String
  description String?
  location    String?
  city        String?
  uf          String?
  remote      Boolean                      @default(false)
  workMode    String?
  seniority   String? // intern | junior | mid | senior | lead
  salaryMin   Int? // monthly BRL when known
  salaryMax   Int?
  salaryText  String?
  postedAt    DateTime?
  dedupeHash  String                       @unique
  embedding   Unsupported("vector(1024)")?
  firstSeenAt DateTime                     @default(now())
  lastSeenAt  DateTime                     @default(now())
  hidden      Boolean                      @default(false)
  interesting Boolean                      @default(false)
  createdAt   DateTime                     @default(now())
  score       JobScore?
  application Application?
  origins     JobOrigin[]
  tailored    TailoredDocument[]

  @@index([createdAt])
}

/// Every place a job was found (dedupe merges cross-board copies into one Job).
model JobOrigin {
  id          String     @id @default(cuid())
  jobId       String
  job         Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source      SourceType
  externalId  String // source id, or url when the source has none
  url         String
  firstSeenAt DateTime   @default(now()) // daily caps count NEW origins per source
  lastSeenAt  DateTime   @default(now())
  runId       String?

  @@unique([source, externalId])
  @@index([source, firstSeenAt])
}

model JobScore {
  id              String   @id @default(cuid())
  jobId           String   @unique
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  passed          Boolean  @default(true)
  filterReason    String? // blocked_company | excluded_keyword | location_mode | salary_below_min | seniority | off_target
  similarity      Float?
  score           Int
  judged          Boolean  @default(false)
  matched         String[]
  matchedEvidence Json     @default("[]") // [{ skill, factIds[] }], grounded against usable facts
  missing         String[]
  demoted         String[] // skills the LLM claimed without evidence (audit)
  reasons         String
  model           String
  profileHash     String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum DiscoveryTrigger {
  manual
  schedule
  rescore
}

enum DiscoveryStatus {
  running
  done
  failed
}

model DiscoveryRun {
  id         String           @id @default(cuid())
  trigger    DiscoveryTrigger
  localDate  String // YYYY-MM-DD America/Sao_Paulo
  status     DiscoveryStatus  @default(running)
  startedAt  DateTime         @default(now())
  finishedAt DateTime?
  outcomes   Json             @default("{}")
  judged     Int              @default(0)

  @@index([trigger, localDate])
}

/// Cached embedding of the profile text used for similarity (keyed by its sha256).
model ProfileVector {
  hash      String                       @id
  text      String
  embedding Unsupported("vector(1024)")?
  createdAt DateTime                     @default(now())
}

// ---------- Applications ----------

enum ApplicationStatus {
  queued
  tailoring
  ready
  applying
  needs_input
  submitted
  failed
  skipped
}

model Application {
  id           String            @id @default(cuid())
  jobId        String            @unique
  job          Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status       ApplicationStatus @default(queued)
  mode         RunMode
  tailoredJson Json? // what was sent (PDF itself is not stored)
  coverLetter  String?
  needsReason  String?
  error        String?
  attempts     Int               @default(0)
  submittedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  answers      FormAnswer[]
  artifacts    Artifact[]
  events       RunEvent[]

  @@index([status])
}

model FormAnswer {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question      String
  answer        String?
  confidence    Float
  source        String // fact | memory | llm | user
  evidence      String[]
  createdAt     DateTime    @default(now())
}

model Artifact {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          String // screenshot_before | screenshot_after | cover_letter
  minioKey      String
  createdAt     DateTime    @default(now())
}

model RunEvent {
  id            String       @id @default(cuid())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  queue         String?
  level         String // info | warn | error
  message       String
  data          Json?
  createdAt     DateTime     @default(now())

  @@index([createdAt])
}

// ---------- Tailoring (F3) ----------

enum TailoredKind {
  resume
  cover_letter
}

enum TailoredStatus {
  queued
  generating
  draft
  needs_review
  approved
  outdated
  failed
}

/// Tailored resume / cover letter per job. Bullets are verbatim facts; generated sentences cite fact ids
/// and pass the deterministic validator (constitution §I). Usable outside dry-run only when approved and
/// its factsHash still matches the current facts.
model TailoredDocument {
  id         String         @id @default(cuid())
  jobId      String
  job        Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind       TailoredKind
  status     TailoredStatus @default(queued)
  lang       String         @default("pt")
  plan       Json           @default("{}")
  sentences  Json           @default("[]")
  validation Json           @default("{}")
  factIds    String[]
  factsHash  String         @default("")
  model      String         @default("")
  userEdited Boolean        @default(false)
  approvedAt DateTime?
  error      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([jobId, kind])
}

/// Results of evaluation suites (tailor traps now; answer traps in F4). Autopilot requires passed=true.
model EvalRun {
  id           String   @id @default(cuid())
  suite        String
  model        String
  cases        Int
  fabrications Int
  passed       Boolean
  report       Json
  createdAt    DateTime @default(now())

  @@index([suite, createdAt])
}
