# ---- Infra (host ports avoid clashing with other local projects) ----
POSTGRES_USER=autoapply
POSTGRES_PASSWORD=autoapply
POSTGRES_DB=autoapply
POSTGRES_PORT=5433
DATABASE_URL=postgresql://autoapply:autoapply@localhost:5433/autoapply
# integration tests (make test-db creates + migrates it)
TEST_DATABASE_URL=postgresql://autoapply:autoapply@localhost:5433/autoapply_test

REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

MINIO_ROOT_USER=autoapply
MINIO_ROOT_PASSWORD=autoapply-secret
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
S3_ENDPOINT=http://localhost:9010
S3_BUCKET=autoapply
S3_REGION=us-east-1

# ---- Local AI (Ollama runs on the host, NOT in Docker: Metal GPU) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# ---- Apps ----
API_PORT=3001
# API binds to loopback only (serves PII without auth); set 0.0.0.0 only if you know why
API_HOST=127.0.0.1
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# 64 hex chars (openssl rand -hex 32), generated by `make setup`. Encrypts platform sessions (F5);
# without a valid key sessions are disabled (never stored in plaintext).
SESSION_ENCRYPTION_KEY=change-me

# ---- Sources ----
# LinkedIn MCP (stickerdaniel/linkedin-mcp-server), streamable HTTP
LINKEDIN_MCP_PORT=8765
LINKEDIN_MCP_URL=http://localhost:8765/mcp
# GitHub read-only fine-grained token (public repos read)
GITHUB_TOKEN=
GITHUB_USER=Gildaciolopes

# ---- Notifications (F6) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
